{
  "format_version": "1.12.0",
  "minecraft:entity": {
    "description": {
      "identifier": "ds:dismantle_quick",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false,
      "runtime_identifier": "minecraft:arrow"
    },
    "component_groups": {
      "ds:despawn":{
        "minecraft:instant_despawn":{}
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": ["sukuna", "projectile", "dismantle", "damage"]
      },
      "minecraft:timer": {
        "looping": true,
        "randomInterval": false,
        "time": 0.0,
        "time_down_event": {
         "event": "ds:timer_event",
         "target": "self"
        }
      },
      "minecraft:projectile": {
        "on_hit": {
          "impact_damage": {
            "damage": 0,
            "knockback": true,
            "semi_random_diff_damage":false,
            "destroy_on_hit": false
          },
          "definition_event": {
            "affectProjectile": true,
            "eventTrigger": {
              "event": "ds:hit_event",
              "target": "self"
            }
          }
        },
        "offset": [ 0, 0, 0 ],
        "power": 1.2,
        "gravity": 0.00,
        "angle_offset": 0.0,
        "inertia": 1,
        "knockback":false,
        "multiple_targets":true,
        "liquid_inertia": 1
      },
      "minecraft:transformation": {
        "into": "ds:despawn",
        "delay": 2.5
      },
      "minecraft:conditional_bandwidth_optimization": {
        "default_values": {
          "max_optimized_distance": 80.0,
          "max_dropped_ticks": 10,
          "use_motion_prediction_hints": true
        }
      }
    },
    "events": {
      "ds:timer_event":{
        "queue_command": {
          "command": [
          "execute if entity @e[scores={Disabled=1..5},hasitem={item=ds:glock},r=13,c=1] run tag @s add gunshot",
          "execute unless entity @s[tag=gunshot] run function dismantlequick"
		  ]
        }
      },
      "ds:hit_event":{
        "queue_command": {
          "command": [
			  "execute unless entity @p[tag=arenaboss] unless entity @s[tag=gunshot] run function sukuna/attacks/dismantle_quick_land",
			  "execute if entity @p[tag=arenaboss] unless entity @s[tag=gunshot] run function bosses/file/weps/phaser_land",
			  "execute if entity @s[tag=gunshot] run function gunshot"
		  ]
        }
      }
    }
  }
}