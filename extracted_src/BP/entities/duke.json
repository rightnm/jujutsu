				},
				"property:luminosity_emblem": { 
					"type": "int", 
					"range": [0, 4], 
					"default": 0,
					"client_sync": true
				},
				"property:awakened": { 
					"type": "int", 
					"range": [0, 4], 
					"default": 0,
					"client_sync": true
        }
      },
      "identifier": "ds:duke",
