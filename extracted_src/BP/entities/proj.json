{
	"format_version": "1.19.40",
	"minecraft:entity": {
		"description": {
			"identifier": "ds:mysterious_artifact",
			"is_spawnable": true,
			"is_summonable": true,
			"is_experimental": false,
			"scripts": {
				"animate": [ "walk" ]
			},
			"animations": {
				"walk": "controller.animation.mysterious_artifact"
			}
		},
		"component_groups": {
			"minecraft:vanish": {
				"minecraft:transformation": {
					"into": "minecraft:area_effect_cloud"
				}
			}
		},

		"components": {
			"minecraft:timer": {
				"looping": true,
				"time": [0.0, 0.0],
				"time_down_event": {
					"event": "mysterious_artifact"
				}
			},
			"minecraft:spell_effects": {
				"add_effects": [
					{
						"effect": "regeneration",
						"duration": 9999999999999999,
						"amplifier": 2,
						"visible": false,
						"display_on_screen_animation": false
					},
					{
						"effect": "instant_health",
						"duration": 0.05
					}
				],
				"remove_effects": ["poison", "wither"]
			},
			"minecraft:on_death": {
				"event": "death"
			},
			"minecraft:breathable": {
				"totalSupply": 15,
				"suffocateTime": 0
			},
			"minecraft:nameable": {},
			"minecraft:knockback_resistance": {
				"value": 100,
				"max": 100
			},
			"minecraft:timer": {
				"looping": true,
				"time": 0,
				"time_down_event": {
					"event": "mysterious_artifact"
				}
			},
			"minecraft:loot": {
				"table": "loot_tables/entities/mysterious_artifact.json"
			},
			"minecraft:type_family": {
				"family": [ "mysterious_artifact"]
			},
			"minecraft:collision_box": {
				"width": 0.45,
				"height": 1
			},
			"minecraft:scale": {
				"value": 1.0
			},
			"minecraft:movement": {
				"value": 0.0
			},
			"minecraft:navigation.walk": {
				"can_path_over_water": true
			},
			"minecraft:movement.basic": {},
			"minecraft:jump.static": {},
			"minecraft:can_climb": {},
			"minecraft:health": {
				"value": 9999,
				"max": 9999
			},
			"minecraft:behavior.float": {
				"priority": 0
			},
			"minecraft:behavior.melee_attack": {
				"priority": 3,
				"speed_multiplier": 1,
				"track_target": true
			},
			"minecraft:behavior.random_stroll": {
				"priority": 6,
				"speed_multiplier": 1
			},
			"minecraft:physics": {},
			"minecraft:environment_sensor": {
				"triggers": [
					{
						"filters": {
							"all_of": [
								{
									"test": "is_daytime",
									"value": false
								}
							]
						},
						"event": "moonlight"
					},
					{
						"filters": {
							"all_of": [
								{
									"test": "is_daytime",
									"value": true
								}
							]
						},
						"event": "daytime"
					}
				]
			}
		},

		"events": {
			"mysterious_artifact": {
				"queue_command": {
					"command": [
						"function my_a"
					]
				}
			},
			"death": {
				"queue_command": {
					"command": [
						"execute as @s[tag=!delete] at @s unless entity @s[scores={Deleter=0..}] unless entity @a[r=3.5,scores={Sneaking=1..,detect_left=1..}] run kill @e[type=item,r=4]",
						"execute as @s[tag=!delete] at @s unless entity @s[scores={Deleter=0..}] unless entity @a[r=3.5,scores={Sneaking=1..,detect_left=1..}] run summon ds:mysterious_artifact",
						"execute as @s[tag=!delete] at @s unless entity @s[scores={Deleter=0..}] unless entity @a[r=3.5,scores={Sneaking=1..,detect_left=1..}] run tp @s ~~-30~"
					]
				}
			},
			"moonlight": {
				"queue_command": {
					"command": [
						"scoreboard objectives add artifactactivated dummy",
						"scoreboard players set @s artifactactivated 1"
					]
				}
			},
			"daytime": {
				"queue_command": {
					"command": [
						"scoreboard objectives add artifactactivated dummy",
						"scoreboard players set @s artifactactivated 0"
					]
				}
			}
		}
	}
}
