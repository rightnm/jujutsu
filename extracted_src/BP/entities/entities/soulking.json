{
  "format_version": "1.20.0",
  "minecraft:entity": {
    "description": {
      "scripts": {
        "animate": [
          "health"
        ]
      },
      "animations": {
        "health": "controller.animation.health"
      },
      "properties": {
        "property:soulking_sword": {
          "type": "int",
          "range": [0, 4],
          "default": 1,
          "client_sync": true
        }
      },
      "identifier": "ds:soulking",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "ds:disappear": {
        "minecraft:transformation": {
          "into": "ds:disappear",
          "delay": 0.0
        }
      }
    },
    "components": {
      "minecraft:nameable": {},
      "minecraft:type_family": {
        "family": ["villain", "soulking", "heroic", "non_sorcerer"]
      },
      "minecraft:collision_box": {
        "width": 0.6,
        "height": 1.9
      },
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": {
        "is_amphibious": true,
        "can_pass_doors": true,
        "can_walk": false,
        "can_break_doors": false
      },
      "minecraft:jump.static": {},
      "minecraft:health": {
        "value": 750,
        "max": 750,
        "min": 1
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": {
              "test": "in_lava",
              "subject": "self",
              "operator": "==",
              "value": true
            },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0,
        "breathes_air": true,
        "breathes_water": true
      },
      "minecraft:attack": {
        "damage": 1
      },
      "minecraft:movement": {
        "value": 0.5
      },
      "minecraft:scale": {
        "value": 1.0
      },
      "minecraft:knockback_resistance": {
        "value": 0.1
      },
      "minecraft:boss": {
        "hud_range": 48,
        "name": "§8-= §r§5Soul, the Void King §8=-"
      },
      "minecraft:on_death": {
        "event": "soulking_die"
      },
      "minecraft:timer": {
        "looping": true,
        "time": 0,
        "time_down_event": {
          "event": "soulking"
        }
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/sus"
      },
      "minecraft:environment_sensor": {
        "triggers": {
          "filters": {
            "test": "is_underwater",
            "operator": "==",
            "value": true
          },
          "event": "minecraft:start_transforming"
        }
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      }
    },
    "events": {
      "soulking_sword": {
        "set_property": {
          "property:soulking_sword": 1
        }
      },
      "soulking_die": {
        "queue_command": {
          "command": [
            "function bosses/file/boss/summons/soulking_death"
          ]
        }
      },
      "soulking": {
        "queue_command": {
          "command": [
            "function bosses/file/boss/summons/soulking"
          ]
        }
      },
      "ds:disappear": {
        "add": {
          "component_groups": [
            "ds:disappear"
          ]
        }
      }
    }
  }
}
