      "mob_die": {
        "queue_command": {
          "command": [
            "function mobs/watcher_spawn",
            "camerashake add @a[r=35] 0.1 0.1"
		  ]
            }
	},
      "combat": {
        "queue_command": {
          "command": [
            "execute as @s[scores={hit=1..}] at @s unless entity @s[scores={combat=1..}] run damage @e[family=hero,r=30] 1 entity_attack entity @e[c=1,family=!hero,family=!regular_human_m1s]",
			"scoreboard players set @s combat 600"
		  ]
            }
  },
			"minecraft:entity_spawned": {
			"queue_command": {
				"command": [
					"scoreboard objectives add weapontype dummy",
					"scoreboard objectives add skincolour dummy",
					"scoreboard objectives add eyes dummy",
					"scoreboard objectives add hair dummy",
					"scoreboard objectives add outfit dummy",
					"event entity @s skincolour",
					"scoreboard players random @s weapontype 0 5",
					"scoreboard players random @s hair 1 17",
					"replaceitem entity @s[scores={weapontype=1}] slot.weapon.mainhand 1 stone_sword",
					"replaceitem entity @s[scores={weapontype=2}] slot.weapon.mainhand 1 iron_sword",
					"replaceitem entity @s[scores={weapontype=3}] slot.weapon.mainhand 1 iron_axe",
					"replaceitem entity @s[scores={weapontype=4}] slot.weapon.mainhand 1 stone_axe",
					"scoreboard players random @s damageadd 1 3",
					"scoreboard players random @s[scores={weapontype=1..}] damageadd 2 5",
					"event entity @s[scores={hair=1}] hair1",
					"event entity @s[scores={hair=2}] hair2",
					"event entity @s[scores={hair=3}] hair3",
