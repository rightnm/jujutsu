{
  "format_version": "1.20.0",
  "minecraft:entity": {
    "description": { 
			"scripts": {
	"animate": [
					"health"
				]
			},
			"animations": {
				"health": "controller.animation.health"
			},
	"properties":{
				"property:eyes": { 
					"type": "int", 
					"range": [0, 100], 
					"default": 1,
					"client_sync": true
				},
				"property:skincolour": { 
					"type": "int", 
					"range": [0, 100], 
					"default": 1,
					"client_sync": true
				},	
				"property:hair": { 
					"type": "int", 
					"range": [0, 100], 
					"default": 1,
					"client_sync": true
				},	
				"property:haircolour": { 
					"type": "int", 
					"range": [0, 100], 
					"default": 1,
					"client_sync": true
				},	
				"property:outfitmale": { 
					"type": "int", 
					"range": [0, 100], 
					"default": 1,
					"client_sync": true
				}	
	},
      "identifier": "ds:faceless_sorcerer",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "minecraft:faceless_sorcerer_components": {

        "minecraft:behavior.controlled_by_player": {
          "speed_multiplier": 1.0
        },
        "minecraft:behavior.ranged_attack": {
          "attack_groups": ["faceless_sorcerer_projectile"]
        }
      }
    },
    "components": {
      "minecraft:nameable": {},
      "minecraft:type_family": {
        "family": ["irongolem", "grade4", "damage"]
      },
      "minecraft:collision_box": {
        "width": 0.6,
        "height": 1.9
      },
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": {
        "is_amphibious": true,
        "can_pass_doors": true,
        "can_walk": true,
        "can_break_doors": true
		      },
      "minecraft:despawn": {
        "despawn_from_distance": {}
      },

      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:health": {
        "value": 75,
        "max": 70
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": {
              "test": "in_lava",
              "subject": "self",
              "operator": "==",
              "value": true
            },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0,
        "breathes_air": true,
        "breathes_water": true
      },
      "minecraft:attack": {
        "damage": 1
      },
      "minecraft:despawn": {
        "despawn_from_distance": {}
      },
      "minecraft:movement": {
        "value": 0.2
      },
      "minecraft:scale": {
        "value": 1.1
      },
      "minecraft:knockback_resistance": {
        "value": 1
	  },
      "minecraft:on_hurt": {
        "event": "combat"
      },
      "minecraft:on_death": {
        "event": "mob_die"
      },
      "minecraft:environment_sensor": {
        "triggers": {
          "filters": {
            "test": "is_underwater",
            "operator": "==",
            "value": true
          },
          "event": "minecraft:start_transforming"
        }
      },
      "minecraft:behavior.melee_attack": {
        "priority": 3,
        "speed_multiplier": 1,
        "track_target": false
      },
      "minecraft:behavior.stomp_turtle_egg": {
        "priority": 4,
        "speed_multiplier": 1,
        "search_range": 10,
        "search_height": 3,
        "goal_radius": 1.14,
        "search_count": 4,
        "interval": 20

      },
      "minecraft:behavior.random_stroll": {
        "priority": 6,
        "speed_multiplier": 1
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 6,
        "probability": 0.02
      },
      "minecraft:behavior.random_look_around": {
        "priority": 7
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 11,
        "reselect_targets": true,
        "must_see": true,
        "within_radius": 64,
        "entity_types": [
          {
            "filters": {
              "any_of": [
                {
                  "test": "is_family",
                  "value": "sorcerer"				  
                }
              ]
            },
            "max_dist": 64
          }
        ]
      },
      "minecraft:follow_range": 300,
      "minecraft:loot": {
        "table": "loot/nothing.json"
      },
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
	  }
