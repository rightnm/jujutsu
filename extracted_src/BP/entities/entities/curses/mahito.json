{
	"format_version": "1.20.0",
	"minecraft:entity": {
		"description": {
			"scripts": {
				"animate": [
					"health",
					"start",
					"divergent",
					"main",
					"rotateleft",
					"rotateright",
					"left",
					"right",
					"jump",
					"sneak",
					"sprint",
					"move",
					"level"
				]
			},
			"animations": {
				"health": "controller.animation.health"
			},
			"properties": {
				"property:body_transfigure": { "type": "int", "range": [0, 2], "default": 0, "client_sync": true },
				"property:body_transformation": { "type": "int", "range": [0, 5], "default": 0, "client_sync": true },
				"property:kamutoke": { "type": "int", "range": [0, 5], "default": 0, "client_sync": true },
				"property:hiten": { "type": "int", "range": [0, 2], "default": 0, "client_sync": true },
				"property:mahito_weapons": { "type": "int", "range": [0, 10], "default": 0, "client_sync": true },

				"property:heart": { "type": "int", "range": [0, 15], "default": 0, "client_sync": true },
				"property:mahito_fit": { "type": "int", "range": [0, 1], "default": 1, "client_sync": true }
			},
			"identifier": "ds:mahito",
			"is_spawnable": true,
			"is_summonable": true,
			"is_experimental": false
		},

		"component_groups": {
			"minecraft:mahito_components": {
				"minecraft:behavior.controlled_by_player": { "speed_multiplier": 1.0 },
				"minecraft:behavior.ranged_attack": { "attack_groups": ["mahito_projectile"] }
			},
			"jjka:body_transformation_rideable": {
				"minecraft:rideable": {
					"seat_count": 1,
					"family_types": ["player", "dummy", "curse", "hostile", "human"],
					"seats": [
						{ "position": [0, 0, 1], "min_rider_count": 0, "max_rider_count": 0, "lock_rider_rotation": 0, "rotate_rider_by": 180 }
					]
				}
			},
			"ds:soul_isomer_spawn": {
            "minecraft:spawn_entity": {"entities": {"spawn_entity":"ds:familiar_entity", "min_wait_time":0, "max_wait_time":0, "num_to_spawn":2, "single_use":true}}
      }
		},

		"components": {
			"minecraft:nameable": {},
			"minecraft:type_family": { "family": ["boss", "special_grade", "purecurse", "curse", "disaster_curse", "villain", "mahito"] },
			"minecraft:collision_box": { "width": 0.6, "height": 1.9 },
			"minecraft:movement.basic": {},
			"minecraft:navigation.walk": { "is_amphibious": true, "can_pass_doors": true, "can_walk": true, "can_break_doors": true },
			"minecraft:annotation.break_door": {},
			"minecraft:jump.static": {},
			"minecraft:can_climb": {},
      "minecraft:boss": {
        "hud_range": 48,
        "name": "§r§lMahito§r"
},
			"minecraft:health": { "value": 700, "max": 700 },
			"minecraft:hurt_on_condition": { "damage_conditions": [ { "filters": { "test": "in_lava", "subject": "self", "operator": "==", "value": true }, "cause": "lava", "damage_per_tick": 4 } ] },
			"minecraft:breathable": { "total_supply": 15, "suffocate_time": 0, "breathes_air": true, "breathes_water": true },
			"minecraft:attack": { "damage": 1 },
			"minecraft:movement": { "value": 0.46 },
			"minecraft:scale": { "value": 1.0 },
			"minecraft:knockback_resistance": { "value": 0.25 },
			"minecraft:on_death": { "event": "mahito_die" },
			"minecraft:loot": { "table": "loot/nothing.json" },
			"minecraft:environment_sensor": { "triggers": { "filters": { "test": "is_underwater", "operator": "==", "value": true }, "event": "minecraft:start_transforming" } },
			"minecraft:behavior.melee_attack": { "priority": 3, "speed_multiplier": 1, "track_target": false },
			"minecraft:behavior.stomp_turtle_egg": { "priority": 4, "speed_multiplier": 1, "search_range": 10, "search_height": 3, "goal_radius": 1.14, "search_count": 4, "interval": 20 },
			"minecraft:behavior.random_stroll": { "priority": 6, "speed_multiplier": 1 },
			"minecraft:behavior.look_at_player": { "priority": 7, "look_distance": 6, "probability": 0.02 },
			"minecraft:behavior.random_look_around": { "priority": 7 },
			"minecraft:behavior.hurt_by_target": { "priority": 1, "entity_types": { "filters": { "none_of": [ { "test": "is_family", "subject": "other", "value": "purecurse" }, { "test": "family", "subject": "other", "value": "curse" } ] }, "max_dist": 64 } },
			"minecraft:behavior.nearest_attackable_target": { "priority": 11, "reselect_targets": true, "must_see": false, "within_radius": 64, "entity_types": [ { "filters": { "none_of": [ { "test": "is_family", "subject": "other", "value": "purecurse" }, { "test": "has_tag", "subject": "other", "value": "curse" }, { "test": "is_family", "subject": "other", "value": "pest" }, { "test": "is_family", "subject": "other", "value": "projectile" }, { "test": "is_family", "subject": "other", "value": "despawncito" }, { "test": "is_family", "subject": "other", "value": "damage" }, { "test": "is_family", "subject": "other", "value": "undead" } ] }, "max_dist": 64 } ] },
			"minecraft:follow_range": 300,
			"minecraft:behavior.float": { "priority": 0 },
			"minecraft:physics": {},
			"minecraft:pushable": { "is_pushable": true, "is_pushable_by_piston": true },
			
			"minecraft:damage_sensor": { "triggers": [
            { "on_damage": { "filters": { "all_of": [ { "test": "has_tag", "subject": "self", "operator": "==", "value": "Frames" }, { "any_of": [ { "test": "has_damage", "subject": "self", "operator": "!=", "value": "self_destruct" }, { "test": "has_damage", "subject": "self", "operator": "!=", "value": "override" }, { "test": "has_damage", "subject": "self", "operator": "!=", "value": "starve" }, { "test": "has_damage", "subject": "self", "operator": "!=", "value": "void" } ] } ] } }, "deals_damage": false },
            { "on_damage": { "filters": { "all_of": [ { "test": "has_tag", "subject": "self", "operator": "==", "value": "idle_transfig" }, { "test": "has_tag", "subject": "self", "operator": "!=", "value": "instant_body" }, { "test": "has_tag", "subject": "self", "operator": "!=", "value": "nocts" }, { "any_of": [ { "test": "has_damage", "subject": "self", "operator": "==", "value": "void" }, { "test": "has_tag", "subject": "damager", "operator": "==", "value": "soul_learned" } ] } ] }, "event": "soul_damage", "target": "self" } },
            { "on_damage": { "filters": { "all_of": [ { "test": "has_tag", "subject": "self", "operator": "==", "value": "instant_body" }, { "test": "has_tag", "subject": "self", "operator": "==", "value": "resistance_0.5x" },   { "any_of": [ { "test": "has_damage", "subject": "self", "operator": "!=", "value": "self_destruct" }, { "test": "has_damage", "subject": "self", "operator": "!=", "value": "self_destruct" }, { "test": "has_damage", "subject": "self", "operator": "!=", "value": "starve" }, { "test": "has_damage", "subject": "self", "operator": "!=", "value": "drowning" }, { "test": "has_damage", "subject": "self", "operator": "!=", "value": "void" } ] } ] } }, "damage_multiplier": 0.5, "damage_modifier": -1 }
            ] }
		},

		"events": {
		    "soul_isomer_spawn": { "add": { "component_groups": [ "ds:soul_isomer_spawn" ] } },
		    "soul_damage": { "queue_command": { "command": ["tag @s[scores={detect_health=1..},tag=!soul_damage] add soul_damage"] } },
			"mahito_die": { "queue_command": { "command": ["summon ds:mahito_dying ~~~ facing ^^^10", "function mobs/mahito_death"] } },
			"minecraft:entity_spawned": { "queue_command": { "command": ["event entity @s test_back"] } },

			"ds:grab_seat": { "add": { "component_groups": ["jjka:body_transformation_rideable"] } },
			"ds:release_seat": { "remove": { "component_groups": ["jjka:body_transformation_rideable"] } },

			"mahito_off": { "set_property": { "property:body_transfigure": 0 } },
			"mahito_on": { "set_property": { "property:body_transfigure": 1 } },
			"mahito_mouthsigns_on": { "set_property": { "property:body_transfigure": 2 } },

			"custom_body_off": { "set_property": { "property:body_transformation": 0 } },
			"heian_on": { "set_property": { "property:body_transformation": 1 } },
			"heian_off": { "set_property": { "property:body_transformation": 0 } },
			"heian_red": { "set_property": { "property:body_transformation": 2 } },
			"instant_body_on": { "set_property": { "property:body_transformation": 3 }, "add": { "component_groups": ["jjka:body_transformation_rideable"] } },
			"instant_body_off": { "set_property": { "property:body_transformation": 0 }, "remove": { "component_groups": ["jjka:body_transformation_rideable"] } },

			"kamutoke_off": { "set_property": { "property:kamutoke": 0 } },
			"kamutoke_on": { "set_property": { "property:kamutoke": 1 } },

			"hiten_off": { "set_property": { "property:hiten": 0 } },
			"hiten": { "set_property": { "property:hiten": 1 } },

			"heart_off": { "set_property": { "property:heart": 0 } },

			"mahito_fit_off": { "set_property": { "property:mahito_fit": 0 } },

			"mahito_metal_off": { "set_property": { "property:mahito_weapons": 0 } },
			"mahito_metal_on": { "set_property": { "property:mahito_weapons": 1 } },
			"mahito_drill_on": { "set_property": { "property:mahito_weapons": 2 } },
			"mahito_murder_manifestation": { "set_property": { "property:mahito_weapons": 3 } },
			"mahito_clankers": { "set_property": { "property:mahito_weapons": 4 } },
			"dual_souls": { "set_property": { "property:mahito_weapons": 5 } },
			"six_souls": { "set_property": { "property:mahito_weapons": 6 } },

			"mahito_blades": { "set_property": { "property:heart": 8 } },
			"mahito_heavy": { "set_property": { "property:heart": 9 } }
		}
	}
}