{
  "format_version": "1.20.0",
  "minecraft:entity": {
    "description": { 
      "scripts": {
        "animate": [
          "health"
        ]
      },
      "animations": {
        "health": "controller.animation.health"
      },
      "properties": {
        "property:beru": { 
          "type": "int", 
          "range": [0, 1], 
          "default": 0,
          "client_sync": true
        },
        "property:awaken": { 
          "type": "int", 
          "range": [0, 1], 
          "default": 0,
          "client_sync": true
        },
        "property:test3": { 
          "type": "int", 
          "range": [0, 7], 
          "default": 0,
          "client_sync": true
        }	
      },
      "identifier": "ds:beru_curse",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "minecraft:beru_curse_components": {
        "minecraft:behavior.controlled_by_player": {
          "speed_multiplier": 1.0
        },
        "minecraft:behavior.ranged_attack": {
          "attack_groups": ["beru_curse_projectile"]
        }
      },
      "ds:disappear": {
        "minecraft:transformation": {
          "into": "ds:disappear",
          "delay": 0.0
        }
      },
      "minecraft:beru_aggro": {
        "minecraft:angry": {
          "duration": -1,
          "broadcast_anger": false,
          "calm_event": {
            "event": "minecraft:stop_aggro",
            "target": "self"
          }
        }
      }
    },
    "components": {
      "minecraft:nameable": {},
      "minecraft:type_family": {
        "family": ["special_grade", "purecurse", "curse", "villain", "disaster_curse"]
      },
      "minecraft:collision_box": {
        "width": 0.5,
        "height": 3
      },
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": {
        "is_amphibious": true,
        "can_pass_doors": true,
        "can_walk": true,
        "can_break_doors": true,
        "avoid_water": false,
        "avoid_damage_blocks": true
      },
      "minecraft:annotation.break_door": {},
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:health": {
        "value": 750,
        "max": 750,
        "min": 1
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": {
              "test": "in_lava",
              "subject": "self",
              "operator": "==",
              "value": true
            },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0,
        "breathes_air": true,
        "breathes_water": true
      },
      "minecraft:attack": {
        "damage": 8
      },
      "minecraft:movement": {
        "value": 0.3
      },
      "minecraft:scale": {
        "value": 1.0
      },
      "minecraft:boss": {
        "hud_range": 64,
        "name": "§r§cVengeful Ant Curse§r"
      },
      "minecraft:knockback_resistance": {
        "value": 0.15
      },
      "minecraft:on_death": {
        "event": "beru_curse_die"
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/sus"
      },
      "minecraft:environment_sensor": {
        "triggers": {
          "filters": {
            "test": "is_underwater",
            "operator": "==",
            "value": true
          },
          "event": "minecraft:start_transforming"
        }
      },
      "minecraft:behavior.melee_attack": {
        "priority": 3,
        "speed_multiplier": 1,
        "track_target": true
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 11,
        "reselect_targets": true,
        "must_see": false,
        "within_radius": 64,
        "entity_types": [
          {
            "filters": {
              "none_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "purecurse"
                },
                {
                  "test": "has_tag",
                  "subject": "other",
                  "value": "curse"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "pest"	
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "projectile"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "despawncito"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "damage"	
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "undead"				  
                }
              ]
            },
            "max_dist": 64
          }
        ]
      },
      "minecraft:follow_range": 300,
      "minecraft:loot": {
        "table": "loot/nothing.json"
      },
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": false
      },
      "minecraft:timer": {
        "looping": true,
        "time": [0.0, 0.0],
        "time_down_event": {
          "event": "beru_curse"
        }
      },
      "minecraft:on_target_acquired": {
        "event": "minecraft:become_aggro",
        "target": "self"
      },
      "minecraft:on_target_escape": {
        "event": "minecraft:stop_aggro",
        "target": "self"
      }
    },
    "events": {
      "beru_awaken": {
        "set_property": {
          "property:awaken": 1
        }
      },
      "beru_awaken_off": {
        "set_property": {
          "property:awaken": 0
        }
      },
      "beru_curse": {
        "queue_command": {
          "command": [
            "function mobs/curses/beru/beru_curse"
          ]
        }
      },
      "beru_curse_die": {
        "queue_command": {
          "command": [
            "camerashake add @a[r=35] 4 0.15"
          ]
        }
      },
      "minecraft:entity_spawned": {
        "queue_command": {
          "command": [
            "event entity @s test_back"
          ]
        }
      },
      "ds:disappear": {
        "add": {
          "component_groups": [
            "ds:disappear"
          ]
        }
      },
      "minecraft:become_aggro": {
        "add": {
          "component_groups": [
            "minecraft:beru_aggro"
          ]
        }
      },
      "minecraft:stop_aggro": {
        "remove": {
          "component_groups": [
            "minecraft:beru_aggro"
          ]
        }
      }
    }
  }
}