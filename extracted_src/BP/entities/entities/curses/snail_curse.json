        "queue_command": {
          "command": [
            "scoreboard players random @p[r=20,tag=!lonewolf] expadd 1 2",
            "execute as @p[r=20,tag=!lonewolf] unless entity @a[r=30,tag=!lonewolf] run scoreboard players random @s expadd 2 3",
            "particle ds:curse_death_small",
            "particle ds:poison_fumes",
            "playsound random.fizz @a ~~~ 1 0.7",
            "effect @a[r=3] poison 4 1 true",
            "function missions/credit/killcredit_grade4curse"
		  ]
      }
    }
  }
