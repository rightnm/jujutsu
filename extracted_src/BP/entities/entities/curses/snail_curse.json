      "minecraft:behavior.nearest_attackable_target": {
        "priority": 11,
        "reselect_targets": true,
        "must_see": true,
        "within_radius": 64,
        "entity_types": [
          {
            "filters": {
              "none_of": [
                {
                  "test": "is_family",
                  "value": "player"
                },
                {
                  "test": "is_family",
                  "value": "sorcerer"
                },
			    {
                  "test": "is_family",
                  "value": "human"
                },					
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "despawncito"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "damage"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "projectile"
	},
                {
                  "test": "has_tag",
                  "subject": "other",
                  "value": "curse"	
	},
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "purecurse"	
	},
                {
                  "test": "is_family",
                  "subject": "other",
