{
  "format_version": "1.20.0",
  "minecraft:entity": {
    "description": {
      "scripts": {
        "animate": [
          "health"
        ]
      },
      "animations": {
        "health": "controller.animation.health"
      },
      "properties": {
        "property:sukuna_markings": {
          "type": "int",
          "range": [0, 10],
          "default": 0,
          "client_sync": true
        },
        "property:megumi": {
          "type": "int",
          "range": [0, 2],
          "default": 0,
          "client_sync": true
        }
      },
      "identifier": "ds:megumi_idle",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "ds:disappear": {
        "minecraft:transformation": {
          "into": "ds:disappear",
          "delay": 0.0
        }
      }
    },
    "components": {
      "minecraft:nameable": {},
      "minecraft:type_family": {
        "family": ["projectile"]
      },
      "minecraft:collision_box": {
        "width": 0.6,
        "height": 1.9
      },
      "minecraft:health": {
        "value": 1,
        "max": 1,
        "min": 1
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": {
              "test": "in_lava",
              "subject": "self",
              "operator": "==",
              "value": true
            },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0,
        "breathes_air": true,
        "breathes_water": true
      },
      "minecraft:attack": {
        "damage": 1
      },
      "minecraft:movement": {
        "value": 0
      },
      "minecraft:physics": {
        "has_gravity": false
      },
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": false
      },
      "minecraft:knockback_resistance": {
        "value": 4
      },
      "minecraft:on_death": {
        "event": "megumi_idle_die"
      },
      "minecraft:timer": {
        "looping": true,
        "time": 0,
        "time_down_event": {
          "event": "megumi_idle"
        }
      },
      "minecraft:loot": {
        "table": "loot/nothing.json"
      },
      "minecraft:environment_sensor": {
        "triggers": {
          "filters": {
            "test": "is_underwater",
            "operator": "==",
            "value": true
          },
          "event": "minecraft:start_transforming"
        }
      },
      "minecraft:behavior.float": {
        "priority": 0
      }
    },
    "events": {
			"sukunatextureoff": {
                "set_property": {
					"property:sukuna_markings": 0
				}
			},
			"sukuna_markings": {
                "set_property": {
					"property:sukuna_markings": 1
				}
			},
			"sukuna_markings_red0": {
                "set_property": {
					"property:sukuna_markings": 2
				}
			},
			"sukuna_markings_red1": {
                "set_property": {
					"property:sukuna_markings": 3
				}
			},
			"sukuna_markings_red": {
                "set_property": {
					"property:sukuna_markings": 4
				}
			},
			"sukuna_markings_fire0": {
                "set_property": {
					"property:sukuna_markings": 5
				}
			},
			"sukuna_markings_fire1": {
                "set_property": {
					"property:sukuna_markings": 6
				}
			},
			"sukuna_markings_fire": {
                "set_property": {
					"property:sukuna_markings": 9
				}
			},
			"megumi_v1": {
                "set_property": {
					"property:megumi": 0
				}
			},
			"megumi_v2": {
                "set_property": {
					"property:megumi": 1
				}
			},
			"megumi_v3": {
                "set_property": {
					"property:megumi": 2
				}
			},
      "megumi_idle_die": {
        "queue_command": {
          "command": [
            "function nothingig"
          ]
        }
      },
      "megumi_idle": {
        "queue_command": {
          "command": [
            "function megumi_idle"
          ]
        }
      },
      "ds:disappear": {
        "add": {
          "component_groups": [
            "ds:disappear"
          ]
        }
      }
    }
  }
}
