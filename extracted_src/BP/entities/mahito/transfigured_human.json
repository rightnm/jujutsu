{
  "format_version": "1.20.0",
  "minecraft:entity": {
    "description": { 
      "scripts": {
        "animate": [
          "health"
        ]
      },
      "animations": {
        "health": "controller.animation.health"
      },
      "properties":{
        "property:transfigured_colour": { 
          "type": "int", 
          "range": [0, 100], 
          "default": 1,
          "client_sync": true
        },
        "property:transfigured_model": { 
          "type": "int", 
          "range": [0, 100], 
          "default": 1,
          "client_sync": true
        }	
      },
      "identifier": "ds:transfigured_human",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "minecraft:transfigured_colour_components": {
        "minecraft:behavior.controlled_by_player": {
          "speed_multiplier": 1.0
        },
        "minecraft:behavior.ranged_attack": {
          "attack_groups": ["transfigured_colour_projectile"]
        }
      }
    },
    "components": {
      "minecraft:nameable": {},
      "minecraft:type_family": {
        "family": ["monster", "purecurse", "curse", "grade3", "transfigured_human"]
      },
      "minecraft:collision_box": {
        "width": 0.6,
        "height": 1.9
      },
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": {
        "is_amphibious": true,
        "can_pass_doors": true,
        "can_walk": true,
        "can_break_doors": true
      },
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:health": {
        "value": 40,
        "max": 40
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": {
              "test": "in_lava",
              "subject": "self",
              "operator": "==",
              "value": true
            },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0,
        "breathes_air": true,
        "breathes_water": true
      },
      "minecraft:movement": {
        "value": 0.25
      },
      "minecraft:scale": {
        "value": 1.2
      },
      "minecraft:despawn": {
        "despawn_from_distance": {}
      },
      "minecraft:knockback_resistance": {
        "value": 0.1
      },
      "minecraft:on_hurt": {
        "event": "combat"
      },
      "minecraft:on_death": {
        "event": "mob_die"
      },
      "minecraft:attack": {
        "damage": 5
      },
      "minecraft:environment_sensor": {
        "triggers": {
          "filters": {
            "test": "is_underwater",
            "operator": "==",
            "value": true
          },
          "event": "minecraft:start_transforming"
        }
      },
      "minecraft:behavior.melee_attack": {
        "priority": 3,
        "speed_multiplier": 1,
        "track_target": true
      },
      "minecraft:behavior.stomp_turtle_egg": {
        "priority": 4,
        "speed_multiplier": 1,
        "search_range": 10,
        "search_height": 3,
        "goal_radius": 1.14,
        "search_count": 4,
        "interval": 20
      },
      "minecraft:behavior.random_stroll": {
        "priority": 6,
        "speed_multiplier": 1
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 6,
        "probability": 0.02
      },
      "minecraft:behavior.random_look_around": {
        "priority": 7
			},
			"minecraft:behavior.hurt_by_target": {
				"priority": 1,
				"entity_types": {
					"filters": {
						"none_of": [
							{
								"test": "is_family",
								"subject": "other",
								"value": "curse"
							},
							{
								"test": "has_tag",
								"subject": "other",
								"value": "idle_transfig"
							}
						]
					},
					"max_dist": 64
				}
			},
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 11,
        "reselect_targets": true,
        "must_see": true,
        "within_radius": 64,
        "entity_types": [
          {
            "filters": {
              "none_of": [
                {
                  "test": "is_family",
                  "value": "player"
                },
                {
                  "test": "is_family",
                  "value": "sorcerer"
                },
			    {
                  "test": "is_family",
                  "value": "human"
                },					
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "despawncito"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "damage"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "projectile"
	},
                {
                  "test": "has_tag",
                  "subject": "other",
                  "value": "curse"	
	},
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "purecurse"	
	},
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "pest"	  
                }
              ]
            },
            "max_dist": 64
          }
        ]
      },
      "minecraft:follow_range": 300,
      "minecraft:loot": {
        "table": "loot/nothing.json"
      },
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
	  }
    },
    "events": {
      "transfigured_colour1": {
        "set_property": {
          "property:transfigured_colour": 0	
        }
      },
      "transfigured_colour2": {
        "set_property": { 
          "property:transfigured_colour": 1	
        }
      },
      "transfigured_colour3": {
        "set_property": {
          "property:transfigured_colour": 2
        }
      },
      "transfigured_colour4": {
        "set_property": {
          "property:transfigured_colour": 3
        }
      },
      "transfigured_colour4": {
        "set_property": {
          "property:transfigured_colour": 3
        }
      },
      "transfigured_colour4": {
        "set_property": {
          "property:transfigured_colour": 3
        }
      },
      "transfigured_colour5": {
        "set_property": {
          "property:transfigured_colour": 4
        }
      },
      "transfigured_colour6": {
        "set_property": {
          "property:transfigured_colour": 5
        }
      },
      "transfigured_colour7": {
        "set_property": {
          "property:transfigured_colour": 6
        }
      },
      "transfigured_colour8": {
        "set_property": {
          "property:transfigured_colour": 7
        }
      },
      "transfigured_model1": {
        "set_property": {
          "property:transfigured_model": 0	
        }
      },
      "transfigured_model2": {
        "set_property": { 
          "property:transfigured_model": 1	
        }
      },
      "transfigured_model3": {
        "set_property": {
          "property:transfigured_model": 2
        }
      },
      "transfigured_model4": {
        "set_property": {
          "property:transfigured_model": 3
        }
      },
      "transfigured_model5": {
        "set_property": {
          "property:transfigured_model": 4
        }
      },
      "transfigured_model6": {
        "set_property": {
          "property:transfigured_model": 5
        }
      },
      "transfigured_model7": {
        "set_property": {
          "property:transfigured_model": 6
        }
      },
      "transfigured_model8": {
        "set_property": {
          "property:transfigured_model": 7
        }
      },
      "mob_die": {
        "queue_command": {
          "command": [
            "scoreboard players random @p[r=20] expadd 4 6",
            "particle ds:curses_energy_hit1 ~~1~",
            "particle ds:blood_splat ~~0.5~",
            "playsound mob.shulker.death @a ~~1~ 1 0.7",
            "playsound mob.drowned.death @a ~~1~ 1 0.7",
            "function missions/credit/killcredit_grade4curse"
          ]
        }
      },
      "combat": {
        "queue_command": {
          "command": [
            "camerashake add @a[r=10] 0.0001 0.0001"
          ]
        }
      },
      "minecraft:entity_spawned": {
        "queue_command": {
          "command": [
            "scoreboard objectives add entity_spawn_anim dummy",
            "scoreboard objectives add skincolour dummy",
            "scoreboard players random @s skincolour 1 8",
            "particle ds:curses_energy_hit1 ~~1~",
            "scoreboard players set @s Stun 40",
            "playsound mob.disfigure2 @a[r=20] ~~1~ 9999 0.4 9999",
            "event entity @s[scores={skincolour=1}] transfigured_colour1",
            "event entity @s[scores={skincolour=2}] transfigured_colour2",
            "event entity @s[scores={skincolour=3}] transfigured_colour3",
            "event entity @s[scores={skincolour=4}] transfigured_colour4",
            "event entity @s[scores={skincolour=5}] transfigured_colour5",
            "event entity @s[scores={skincolour=6}] transfigured_colour6",
            "event entity @s[scores={skincolour=7}] transfigured_colour7",
            "event entity @s[scores={skincolour=8}] transfigured_colour8",
            "scoreboard players random @s skincolour 1 8",
            "event entity @s[scores={skincolour=1}] transfigured_model1",
            "event entity @s[scores={skincolour=2}] transfigured_model2",
            "event entity @s[scores={skincolour=3}] transfigured_model3",
            "event entity @s[scores={skincolour=4}] transfigured_model4",
            "event entity @s[scores={skincolour=5}] transfigured_model5",
            "event entity @s[scores={skincolour=6}] transfigured_model6",
            "event entity @s[scores={skincolour=7}] transfigured_model7",
            "event entity @s[scores={skincolour=8}] transfigured_model8"
          ]
        }
      }
    }
  }
}
