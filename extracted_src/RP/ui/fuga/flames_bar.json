{
  "namespace": "avatar_flames_bar",
  
  "image_uv": {
    "anim_type": "uv",
    "$set_image_uv|default": [ 0, 0 ],
    "duration": "$set_fps",
    "from": "$set_image_uv",
    "to": "$set_image_uv",
    "easing": "linear",
    "next": "$set_image_uv_next"
  },

  "enter_by_alpha": {
    "anim_type": "alpha",
    "easing": "linear",
    "duration": 0.1,
    "from": 0.0,
    "to": 1.0
  },
  "stay_by_alpha": {
    "anim_type": "alpha",
    "easing": "linear",
    "duration": 0.1,
    "from": 1.0,
    "to": 1.0
  },
  "destroy_by_alpha": {
    "anim_type": "alpha",
    "easing": "linear",
    "duration": 0.2,
    "from": 1.0,
    "to": 0.0,
    "destroy_at_end": "flames_bar_image"
  },

  "flames_bar_image": {
    "$set_alpha|default": 0.0,
    "$flames_uv|default": "base_full",
    "$flames_texture|default": "textures/ui/flames/empty",

    "type": "image",
    "size": [ 90, 90 ],
    "uv_size": [ 120, 32 ],
    "uv": "('@avatar_flames_bar_uv.image_uv_' + $flames_uv)",
    "texture": "('textures/ui/flames/' + $flames_texture)",
    "alpha": "$set_alpha",
    "layer": 0
  },

  
  "flames_bar_stack_panel": {
    "type": "stack_panel",
    "size": [ 120.30, "100%c" ],
    "controls": [
      {
        "avatar_flames@avatar_flames_bar.flames_bar_image": {
          "variables": [

            { "requires": "(not (($title_text - 'fuga_bar0') = $title_text))", "$flames_uv": "base_full0", "$flames_texture": "flames_bar", "$set_alpha": 1.0 },
            { "requires": "(not (($title_text - 'fuga_bar1') = $title_text))", "$flames_uv": "base_full1", "$flames_texture": "flames_bar", "$set_alpha": 1.0 },
            { "requires": "(not (($title_text - 'fuga_bar2') = $title_text))", "$flames_uv": "base_full2", "$flames_texture": "flames_bar", "$set_alpha": 1.0 },
            { "requires": "(not (($title_text - 'fuga_bar3') = $title_text))", "$flames_uv": "base_full3", "$flames_texture": "flames_bar", "$set_alpha": 1.0 },
            { "requires": "(not (($title_text - 'fuga_bar4') = $title_text))", "$flames_uv": "base_full4", "$flames_texture": "flames_bar", "$set_alpha": 1.0 },
            { "requires": "(not (($title_text - 'fuga_bar5') = $title_text))", "$flames_uv": "base_full5", "$flames_texture": "flames_bar", "$set_alpha": 1.0 },
            { "requires": "(not (($title_text - 'fuga_bar6') = $title_text))", "$flames_uv": "base_full6", "$flames_texture": "flames_bar", "$set_alpha": 1.0 },
            { "requires": "(not (($title_text - 'fuga_bar7') = $title_text))", "$flames_uv": "base_full7", "$flames_texture": "flames_bar", "$set_alpha": 1.0 },
            { "requires": "(not (($title_text - 'fuga_bar8') = $title_text))", "$flames_uv": "base_full8", "$flames_texture": "flames_bar", "$set_alpha": 1.0 },
            { "requires": "(not (($title_text - 'fuga_bar9') = $title_text))", "$flames_uv": "base_full9", "$flames_texture": "flames_bar", "$set_alpha": 1.0 },
            { "requires": "(not (($title_text - 'fuga_bar10') = $title_text))", "$flames_uv": "base_full10", "$flames_texture": "flames_bar", "$set_alpha": 1.0 },
            { "requires": "(not (($title_text - 'fuga_bar11') = $title_text))", "$flames_uv": "base_full11", "$flames_texture": "flames_bar", "$set_alpha": 1.0 },
            { "requires": "(not (($title_text - 'fuga_bar12') = $title_text))", "$flames_uv": "base_full12", "$flames_texture": "flames_bar", "$set_alpha": 1.0 },
            { "requires": "(not (($title_text - 'fuga_bar13') = $title_text))", "$flames_uv": "base_full13", "$flames_texture": "flames_bar", "$set_alpha": 1.0 },
            { "requires": "(not (($title_text - 'fuga_bar14') = $title_text))", "$flames_uv": "base_full14", "$flames_texture": "flames_bar", "$set_alpha": 1.0 },
            { "requires": "(not (($title_text - 'fuga_bar15') = $title_text))", "$flames_uv": "base_full15", "$flames_texture": "flames_bar", "$set_alpha": 1.0 },
            { "requires": "(not (($title_text - 'fuga_bar16') = $title_text))", "$flames_uv": "base_full16", "$flames_texture": "flames_bar", "$set_alpha": 1.0 },
            { "requires": "(not (($title_text - 'fuga_bar17') = $title_text))", "$flames_uv": "base_full17", "$flames_texture": "flames_bar", "$set_alpha": 1.0 },
            { "requires": "(not (($title_text - 'fuga_bar18') = $title_text))", "$flames_uv": "base_full18", "$flames_texture": "flames_bar", "$set_alpha": 1.0 },
            { "requires": "(not (($title_text - 'fuga_bar19') = $title_text))", "$flames_uv": "base_full19", "$flames_texture": "flames_bar", "$set_alpha": 1.0 },
            { "requires": "(not (($title_text - 'fuga_bar20') = $title_text))", "$flames_uv": "base_full20", "$flames_texture": "flames_bar", "$set_alpha": 1.0 },
            { "requires": "(not (($title_text - 'fuga_bar21') = $title_text))", "$flames_uv": "base_full21", "$flames_texture": "flames_bar", "$set_alpha": 1.0 },
            { "requires": "(not (($title_text - 'fuga_bar22') = $title_text))", "$flames_uv": "base_full22", "$flames_texture": "flames_bar", "$set_alpha": 1.0 },
            { "requires": "(not (($title_text - 'fuga_bar23') = $title_text))", "$flames_uv": "base_full23", "$flames_texture": "flames_bar", "$set_alpha": 1.0 },
            { "requires": "(not (($title_text - 'fuga_bar24') = $title_text))", "$flames_uv": "base_full24", "$flames_texture": "flames_bar", "$set_alpha": 1.0 },
            { "requires": "(not (($title_text - 'fuga_bar25') = $title_text))", "$flames_uv": "base_full25", "$flames_texture": "flames_bar", "$set_alpha": 1.0 },
            { "requires": "(not (($title_text - 'fuga_bar26') = $title_text))", "$flames_uv": "base_full26", "$flames_texture": "flames_bar", "$set_alpha": 1.0 },
            { "requires": "(not (($title_text - 'fuga_bar27') = $title_text))", "$flames_uv": "base_full27", "$flames_texture": "flames_bar", "$set_alpha": 1.0 },
            { "requires": "(not (($title_text - 'fuga_bar28') = $title_text))", "$flames_uv": "base_full28", "$flames_texture": "flames_bar", "$set_alpha": 1.0 },
            { "requires": "(not (($title_text - 'fuga_bar29') = $title_text))", "$flames_uv": "base_full29", "$flames_texture": "flames_bar", "$set_alpha": 1.0 },
            { "requires": "(not (($title_text - 'fuga_bar30') = $title_text))", "$flames_uv": "base_full30", "$flames_texture": "flames_bar", "$set_alpha": 1.0 },
            { "requires": "(not (($title_text - 'fuga_bar31') = $title_text))", "$flames_uv": "base_full31", "$flames_texture": "flames_bar", "$set_alpha": 1.0 },
            { "requires": "(not (($title_text - 'fuga_bar32') = $title_text))", "$flames_uv": "base_full32", "$flames_texture": "flames_bar", "$set_alpha": 1.0 },
            { "requires": "(not (($title_text - 'reset') = $title_text))", "$flames_uv": "base_full0", "$flames_texture": "empty", "$set_alpha": 0.0 }
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "#is_creative_mode",
        "binding_type": "global"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not #is_creative_mode)",
        "target_property_name": "#is_not_creative_mode"
      },
      {
        "binding_type": "view",
        "source_property_name": "$visible_binding",
        "target_property_name": "#visible"
      }
    ]
  },
  
  "flames_bar_offset_control_default": {
    "type": "panel",
    "controls": [
      {
        "survival_default@avatar_flames_bar.flames_bar_stack_panel": {
          "offset": [ 75, -6 ],
          "$visible_binding": "(#is_not_creative_mode)"
        }
      },
      {
        "creative_default@avatar_flames_bar.flames_bar_stack_panel": {
          "offset": [ 75, -6 ],
          "$visible_binding": "(#is_creative_mode)"
        }
      }
    ]
  },

  "flames_bar_offset_control_perf": {
    "type": "panel",
    "controls": [
      {
        "survival_default@avatar_flames_bar.flames_bar_stack_panel": {
          "offset": [ 75, -6 ],
          "$visible_binding": "(#is_not_creative_mode)",
          "ignored": "(not (($title_text - 'moveup') = $title_text)) or not(($title_text - 'center') = $title_text)"
        }
      },
      {
        "survival_riding@avatar_flames_bar.flames_bar_stack_panel": {
          "offset": [ 75, -6 ],
          "$visible_binding": "(#is_not_creative_mode)",
          "ignored": "(($title_text - 'moveup') = $title_text) or not(($title_text - 'center') = $title_text)"
        }
      },
      {
        "survival_riding@avatar_flames_bar.flames_bar_stack_panel": {
          "anchor_from": "top_middle",
          "anchor_to": "center",
          "offset": [ 75, -6 ],
          "$visible_binding": "(#is_not_creative_mode)",
          "ignored": "(($title_text - 'center') = $title_text)"
        }
      },
      {
        "creative_default@avatar_flames_bar.flames_bar_stack_panel": {
          "offset": [ 75, -6 ],
          "$visible_binding": "(#is_creative_mode)",
          "ignored": "(not(($title_text - 'center') = $title_text))"
        }
      },
      {
        "creative_default@avatar_flames_bar.flames_bar_stack_panel": {
          "anchor_from": "top_middle",
          "anchor_to": "center",
          "offset": [ 75, -6 ],
          "$visible_binding": "(#is_creative_mode)",
          "ignored": "(($title_text - 'center') = $title_text)"
        }
      }
    ]
  },

  "flames_bar_offset_control@common.empty_panel": {
    "anchor_from": "center",
    "anchor_to": "top_middle",
    "offset": [ 75, -6 ],
    "controls": [
      {
        "default@avatar_flames_bar.flames_bar_offset_control_perf": {
          "ignored": "$console_edition"
        }
      },
      {
        "default@avatar_flames_bar.flames_bar_offset_control_perf": {
          "ignored": "(not $console_edition)"
        }
      }
    ]
  }
}