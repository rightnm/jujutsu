{
    "namespace": "heroic_stats",
    "$schema": "https://kalmemarq.github.io/Bugrock-JSON-UI-Schemas/ui.schema.json",
    "button": {
        "type": "panel",
        "size": [
            60,
            60
        ],
        "$button_texture|default": "items/apple",
        "$button_title|default": "§cEndurance",
        "$index|default": 0,
        "controls": [
            {
                "textureHandler": {
                    "type": "panel",
                    "size": [
                        44,
                        44
                    ],
                    "anchor_from": "center",
                    "anchor_to": "center",
                    "layer": 3,
                    "controls": [
                        {
                            "png": {
                                "type": "image",
                                "size": [
                                    32,
                                    32
                                ],
                                "anchor_from": "top_middle",
                                "anchor_to": "top_middle",
                                "texture": "('textures/' + $button_texture)"
                            }
                        },
                        {
                            "text": {
                                "type": "label",
                                "text": "$button_title",
                                "anchor_from": "bottom_middle",
                                "anchor_to": "bottom_middle",
                                "font_scale_factor": 0.8
                            }
                        }
                    ]
                }
            },
            {
                "realButton": {
                    "type": "button",
                    "size": [
                        "100%-4px",
                        "100%-4px"
                    ],
                    "focus_magnet_enabled": true,
                    "focus_enabled": true,
                    "hover_control": "hover",
                    "button_mappings": [
                        {
                            "from_button_id": "button.menu_select",
                            "to_button_id": "button.student_button",
                            "mapping_type": "pressed"
                        },
                        {
                            "from_button_id": "button.menu_ok",
                            "to_button_id": "button.student_button",
                            "mapping_type": "focused"
                        }
                    ],
                    "bindings": [
                        {
                            "binding_type": "collection_details",
                            "binding_collection_name": "student_buttons_collection",
                            "binding_collection_prefix": "student_buttons"
                        }
                    ],
                    "controls": [
                        {
                            "default": {
                                "type": "image",
                                "size": [
                                    "100%",
                                    "100%"
                                ],
                                "texture": "textures/heroic/button"
                            }
                        },
                        {
                            "hover": {
                                "type": "image",
                                "size": [
                                    "100%",
                                    "100%"
                                ],
                                "controls": [
                                    {
                                        "fac": {
                                            "type": "stack_panel",
                                            "size": [
                                                0,
                                                0
                                            ],
                                            "anchor_from": "center",
                                            "anchor_to": "center",
                                            "orientation": "horizontal",
                                            "offset": [
                                                0,
                                                0
                                            ],
                                            "layer": 20,
                                            "collection_name": "actions_collection",
                                            "controls": [
                                                {
                                                    "Strength@heroic_stats.button_details": {
                                                        "collection_index": "($index)",
                                                        "$button_texture|default": "items/strength",
                                                        "$button_title|default": "§cStrength"
                                                    }
                                                }
                                            ]
                                        }
                                    }
                                ],
                                "texture": "textures/heroic/button_hover",
                                "layer": 1
                            }
                        }
                    ]
                }
            }
        ]
    },
    "button_details": {
        "type": "custom",
        "renderer": "hover_text_renderer",
        "allow_clipping": false,
        "layer": 70,
        "bindings": [
            {
                "binding_name": "#button_name_text",
                "binding_type": "collection",
                "binding_collection_name": "actions_collection"
            },
            {
                "binding_type": "view",
                "source_property_name": "#button_name_text",
                "target_property_name": "#hover_text"
            }
        ]
    },
    "ui": {
        "type": "panel",
        "layer": 1,
        "size": [
            250,
            90
        ],
        "controls": [
            {
                "title@hanging_title": {}
            },
            {
                "background": {
                    "type": "image",
                    "texture": "textures/heroic/background",
                    "size": [
                        "100%",
                        "100%"
                    ],
                    "layer": -1
                }
            },
            {
                "close": {
                    "type": "button",
                    "size": [
                        12,
                        12
                    ],
                    "offset": [
                        4,
                        -4
                    ],
                    "focus_enabled": true,
                    "focus_magnet_enabled": false,
                    "hover_control": "hover",
                    "anchor_from": "top_right",
                    "anchor_to": "top_right",
                    "controls": [
                        {
                            "hover": {
                                "type": "image",
                                "layer": 1,
                                "texture": "textures/heroic/close_hover"
                            }
                        },
                        {
                            "default": {
                                "type": "image",
                                "texture": "textures/heroic/close"
                            }
                        }
                    ],
                    "button_mappings": [
                        {
                            "from_button_id": "button.menu_select",
                            "to_button_id": "button.menu_exit",
                            "mapping_type": "pressed"
                        },
                        {
                            "from_button_id": "button.menu_ok",
                            "to_button_id": "button.menu_exit",
                            "mapping_type": "focused"
                        }
                    ]
                }
            },
            {
                "description": {
                    "type": "image",
                    "texture": "textures/ui/hud_tip_text_background",
                    "size": [
                        220,
                        10
                    ],
                    "alpha": 0.3,
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "offset": [
                        0,
                        15
                    ],
                    "controls": [
                        {
                            "text": {
                                "type": "label",
                                "font_scale_factor": 0.8,
                                "layer": 1,
                                "text": "§7What would you like to upgrade?"
                            }
                        }
                    ]
                }
            },
            {
                "stack": {
                    "type": "stack_panel",
                    "size": [
                        240,
                        200
                    ],
                    "anchor_from": "center",
                    "anchor_to": "center",
                    "orientation": "horizontal",
                    "offset": [
                        0,
                        80
                    ],
                    "collection_name": "student_buttons_collection",
                    "controls": [
                        {
                            "Endurance@heroic_stats.button": {
                                "collection_index": 0,
                                "$index": 0,
                                "$button_texture|default": "items/endurance",
                                "$button_title|default": "§aEndurance"
                            }
                        },
                        {
                            "Strength@heroic_stats.button": {
                                "collection_index": 1,
                                "$index": 1,
                                "$button_texture|default": "items/strength",
                                "$button_title|default": "§cStrength"
                            }
                        },
                        {
                            "Agility@heroic_stats.button": {
                                "collection_index": 2,
                                "$index": 2,
                                "$button_texture|default": "items/speed",
                                "$button_title|default": "§3Agility"
                            }
                        },
                        {
                            "Weapons@heroic_stats.button": {
                                "collection_index": 3,
                                "$index": 3,
                                "$button_texture|default": "items/cursed",
                                "$button_title|default": "§bEnergy Cap"
                            }
                        }
                    ]
                }
            }
        ]
    },
    "hanging_title": {
        "type": "image",
        "size": [
            "100%c+10px",
            "100%c+5px"
        ],
        "offset": [
            0,
            "-50%c"
        ],
        "texture": "textures/heroic/background",
        "anchor_from": "top_middle",
        "anchor_to": "top_middle",
        "$title_text|default": "Stats",
        "$scale|default": 1.2,
        "anims": [
            "heroic_stats.rgb_r"
        ],
        "controls": [
            {
                "text": {
                    "type": "label",
                    "text": "$title_text",
                    "font_type": "MinecraftTen",
                    "font_scale_factor": "$scale",
                    "offset": [
                        0,
                        -2
                    ]
                }
            }
        ]
    },
    "rgb_r": {
        "anim_type": "color",
        "from": [
            0,
            0,
            0
        ],
        "to": [
            0,
            0,
            0
        ],
        "duration": 1,
        "next": "heroic_stats.rgb_g"
    },
    "rgb_g": {
        "anim_type": "color",
        "from": [
            0,
            0,
            0
        ],
        "to": [
            0,
            0,
            0
        ],
        "duration": 1,
        "next": "heroic_stats.rgb_b"
    },
    "rgb_b": {
        "anim_type": "color",
        "from": [
            0,
            0,
            0
        ],
        "to": [
            0,
            0,
            0
        ],
        "duration": 1,
        "next": "heroic_stats.rgb_r"
    }
}