{
    "format_version": "1.19.0",
    "animation_controllers": {
        "controller.animation.mahito_heavy.idle": {
            "initial_state": "idle",
            "states": {
                "idle": {
                    "animations": [
                        {
                            "mahito_heavy_idle": "query.property('property:heart') == 9"
                        }
                    ],
                    "transitions": [
                        {
                            "walk": "query.is_moving && query.is_on_ground && !q.is_sprinting && query.property('property:heart') == 9"
                        },
                        {
                            "sprint": "query.is_on_ground && q.is_sprinting && query.property('property:heart') == 9"
                        }
                    ],
                    "blend_transition": 0.1
                },
                "walk": {
                    "animations": [
                        {
                            "mahito_heavy_walk": "query.property('property:heart') == 9"
                        }
                    ],
                    "transitions": [
                        {
                            "idle": "query.is_on_ground && !query.is_moving && query.property('property:heart') == 9"
                        },
                        {
                            "sprint": "query.is_on_ground && q.is_sprinting && query.property('property:heart') == 9"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "sprint": {
                    "animations": [
                        {
                            "mahito_heavy_sprint": "query.property('property:heart') == 9"
                        }
                    ],
                    "transitions": [
                        {
                            "idle": "query.is_on_ground && !query.is_moving && query.property('property:heart') == 9"
                        },
                        {
                            "walk": "query.is_moving && query.is_on_ground && !q.is_sprinting && query.property('property:heart') == 9"
                        }
                    ],
                    "blend_transition": 0.1
                }
            }
        }
    }
}
