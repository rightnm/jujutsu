{
    "format_version": "1.19.0",
    "animation_controllers": {
        "controller.animation.okarun_idle": {
            "initial_state": "idle",
            "states": {
                "idle": {
                    "animations": [
                        {
                            "okarun_idle": "query.property('property:okarun') == 1"
                        }
                    ],
                    "transitions": [
                        {
                            "walk": "query.is_moving && query.is_on_ground && !q.is_sprinting && query.property('property:okarun') == 1"
                        },
                        {
                            "sprint": "query.is_on_ground && q.is_sprinting && query.property('property:okarun') == 1"
                        },
                        {
                            "jump": "query.is_jumping && query.property('property:okarun') == 1 && !query.is_in_water"
                        }
                    ],
                    "blend_transition": 0.0
                },
                "walk": {
                    "animations": [
                        {
                            "okarun_walk": "query.property('property:okarun') == 1"
                        }
                    ],
                    "transitions": [
                        {
                            "idle": "query.is_on_ground && !query.is_moving && query.property('property:okarun') == 1"
                        },
                        {
                            "sprint": "query.is_on_ground && q.is_sprinting && query.property('property:okarun') == 1"
                        },
                        {
                            "jump": "query.is_jumping && query.property('property:okarun') == 1 && !query.is_in_water"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "sprint": {
                    "animations": [
                        {
                            "okarun_sprint": "query.property('property:okarun') == 1"
                        }
                    ],
                    "transitions": [
                        {
                            "walk": "query.is_moving && query.is_on_ground && !q.is_sprinting && query.property('property:okarun') == 1"
                        },
                        {
                            "idle": "query.is_on_ground && !query.is_moving && query.property('property:okarun') == 1"
                        },
                        {
                            "jump": "query.is_jumping && query.property('property:okarun') == 1 && !query.is_in_water"
                        }
                    ],
                    "blend_transition": 0.0
                },
                "jump": {
                    "animations": [
                        {
                            "okarun_jump": "query.property('property:okarun') == 1 && !query.is_in_water"
                        }
                    ],
                    "transitions": [
                        {
                            "idle": "query.is_on_ground && !query.is_moving && query.property('property:okarun') == 1"
                        },
                        {
                            "walk": "query.is_moving && query.is_on_ground && !q.is_sprinting && query.property('property:okarun') == 1"
                        },
                        {
                            "sprint": "query.is_on_ground && q.is_sprinting && query.property('property:okarun') == 1"
                        }
                    ],
                    "blend_transition": 0.1
                }
            }
        }
    }
}
