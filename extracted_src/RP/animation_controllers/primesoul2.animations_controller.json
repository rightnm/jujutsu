{
    "format_version": "1.19.0",
    "animation_controllers": {
        "controller.animation.primesoul_idle2": {
            "initial_state": "idle",
            "states": {
                "idle": {
                    "animations": [
                        {
                            "primesoul_idle2": "query.property('property:weapon') == 2"
                        }
                    ],
                    "transitions": [
                        {
                            "walk": "query.is_moving && query.is_on_ground && !q.is_sprinting && query.property('property:weapon') == 2"
                        },
                        {
                            "sprint": "query.is_on_ground && q.is_sprinting && query.property('property:weapon') == 2"
                        },
                        {
                            "jump": "query.is_jumping && query.property('property:weapon') == 2 && !query.is_in_water"
                        }
                    ],
                    "blend_transition": 0.0
                },
                "walk": {
                    "animations": [
                        {
                            "primesoul_idle2": "query.property('property:weapon') == 2"
                        }
                    ],
                    "transitions": [
                        {
                            "idle": "query.is_on_ground && !query.is_moving && query.property('property:weapon') == 2"
                        },
                        {
                            "sprint": "query.is_on_ground && q.is_sprinting && query.property('property:weapon') == 2"
                        },
                        {
                            "jump": "query.is_jumping && query.property('property:weapon') == 2 && !query.is_in_water"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "sprint": {
                    "animations": [
                        {
                            "primesoul_sprint2": "query.property('property:weapon') == 2"
                        }
                    ],
                    "transitions": [
                        {
                            "walk": "query.is_moving && query.is_on_ground && !q.is_sprinting && query.property('property:weapon') == 2"
                        },
                        {
                            "idle": "query.is_on_ground && !query.is_moving && query.property('property:weapon') == 2"
                        },
                        {
                            "jump": "query.is_jumping && query.property('property:weapon') == 2 && !query.is_in_water"
                        }
                    ],
                    "blend_transition": 0.0
                },
                "jump": {
                    "animations": [
                        {
                            "primesoul_jump2": "query.property('property:weapon') == 2 && !query.is_in_water"
                        }
                    ],
                    "transitions": [
                        {
                            "idle": "query.is_on_ground && !query.is_moving && query.property('property:weapon') == 2"
                        },
                        {
                            "walk": "query.is_moving && query.is_on_ground && !q.is_sprinting && query.property('property:weapon') == 2"
                        },
                        {
                            "sprint": "query.is_on_ground && q.is_sprinting && query.property('property:weapon') == 2"
                        }
                    ],
                    "blend_transition": 0.1
                }
            }
        }
    }
}
