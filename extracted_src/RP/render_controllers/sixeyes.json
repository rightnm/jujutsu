{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.sixeyes": {
      "arrays": {
        "textures": {
          "Array.skins": [
            "Texture.textureoff",
            "Texture.sixeyes"
          ]
        }
      },
"ignore_lighting": true,
      "geometry": "Geometry.sixeyes",
      "materials": [{"*": "Material.emissive"}],
      "textures": [
        "query.property('property:sixeyes') == 1 ? Texture.sixeyes : (query.property('property:sixeyes') == 0 ? Texture.textureoff)"
      ]
    }
  }
}
