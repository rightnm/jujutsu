{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.extermination_sword": {
      "arrays": {
        "textures": {
          "Array.skins": [
            "Texture.textureoff",
            "Texture.extermination_sword"
          ]
        }
      },
      "geometry": "Geometry.extermination_sword",
      "materials": [{"*": "Material.emissive"}],
      "textures": [
        "query.property('property:extermination_sword') == 1 ? Texture.extermination_sword : (query.property('property:extermination_sword') == 0 ? Texture.textureoff)"
      ]
    }
  }
}
