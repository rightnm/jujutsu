{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.mahoraga_wheel": {
      "arrays": {
        "textures": {
          "Array.skins": [
            "Texture.textureoff",
            "Texture.mahoraga_wheel"
          ]
        }
      },
"ignore_lighting": true,
      "geometry": "Geometry.mahoraga_wheel",
      "materials": [{"*": "Material.emissive"}],
      "textures": [
        "query.property('property:mahoraga_wheel') == 1 ? Texture.mahoraga_wheel : (query.property('property:mahoraga_wheel') == 0 ? Texture.textureoff)"
      ]
    }
  }
}
