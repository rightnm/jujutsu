{
  "format_version": "1.12.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "ds:beru_curse",
      "materials": {
        "default": "entity_emissive_alpha"
      },
      "textures": {
        "default": "textures/entity/curses/beru"
      },
      "geometry": {
        "default": "geometry.beru"
      },
      "scripts": {
        "pre_animation": [
          "variable.tcos0 = (Math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;",
          "variable.attack = Math.sin((1.0 - (1.0 - variable.attack_time) * (1.0 - variable.attack_time)) * 180.0) * 57.3;",
          "variable.attack2 = Math.sin(variable.attack_time * 180.0) * 57.3;",
          "variable.z_bob = Math.cos(query.life_time * 103.13244) * 2.865 + 2.865;",
          "variable.x_bob = Math.sin(query.life_time * 76.776372) * 2.865;",
          "variable.is_awakened = query.property('property:awaken') == 1;"
        ],
        "animate": [
          "root",
          { "admire": "query.is_admiring" },
          { "humanoid_big_head": "query.is_baby" },
          { "celebrate_hunt": "query.is_celebrating" },
          { "celebrate_hunt_special": "query.is_celebrating_special" },
          { "move": "query.ground_speed > 0.1" }, // Only play move animation when moving
          { "bob": "query.ground_speed > 0.1" }, // Only play bob animation when moving
          "look_at_target_controller",
          "piglin_attack_controller",
          { "movement_controller": "!variable.is_awakened" },
          { "movement_controller_awaken": "variable.is_awakened" },
          "riding_controller"
        ]
      },
      "animations": {
        "movement_controller": "controller.animation.beru.movement",
        "movement_controller_awaken": "controller.animation.beru_awaken.movement",
        "static": "animation.beru.idle",
        "move": "animation.beru.move2",
        "sprint": "animation.beru.move2",
        "static_awaken": "animation.beru.idle_awaken",
        "move_awaken": "animation.beru.move2_awaken",
        "sprint_awaken": "animation.beru.move2_awaken",
        "bob": "animation.humanoid.bob",
        "humanoid_big_head": "animation.humanoid.big_head",
        "admire": "animation.piglin.admire",
        "celebrate_hunt": "animation.piglin.celebrate_hunt",
        "celebrate_hunt_special": "animation.piglin.celebrate_hunt_special",
        "look_at_target_controller": "controller.animation.humanoid.look_at_target",
        "look_at_target_default": "animation.humanoid.look_at_target.default",
        "look_at_target_gliding": "animation.humanoid.look_at_target.gliding",
        "look_at_target_swimming": "animation.humanoid.look_at_target.swimming",
        "piglin_attack_controller": "controller.animation.piglin.attack",
        "crossbow_hold": "animation.piglin.crossbow.hold",
        "crossbow_charge": "animation.piglin.crossbow.charge",
        "riding_controller": "controller.animation.humanoid.riding",
        "riding.arms": "animation.humanoid.riding.arms",
        "riding.legs": "animation.humanoid.riding.legs"
      },
      "particle_effects": {
        "ant_eye1": "ds:ant_eye1",
        "beru_slice1": "ds:beru_slice1",
        "beru_slice2": "ds:beru_slice2",
        "beru_slice3": "ds:beru_slice3",
        "beru_slice4": "ds:beru_slice4",
        "ant_breath": "ds:ant_breath",
        "large_impact1": "ds:large_impact1",
        "large_impact2": "ds:large_impact2",
        "ground_slam1": "ds:ground_slam1",
        "ground_slam2": "ds:ground_slam2",
        "ground_slam3": "ds:ground_slam3",
        "rubble3": "ds:rubble3",
        "speedblitzing": "ds:speedblitzing",
        "turbo_intensity1": "ds:turbo_intensity1",
        "turbo_intensity2": "ds:turbo_intensity2",
        "turbo_intensity3": "ds:turbo_intensity3",
        "turbo_intensity4": "ds:turbo_intensity4",
        "beru_eye": "ds:beru_eye",
        "rampage1": "ds:rampage1",
        "rampage2": "ds:rampage2",
        "rampage3": "ds:rampage3",
        "rampage4": "ds:rampage4",
        "rampage5": "ds:rampage5",
        "rampage6": "ds:rampage6",
        "rampage7": "ds:rampage7",
        "rampage_aura": "ds:rampage_aura",
        "rampage_star": "ds:rampage_star",
        "ground_slam1": "ds:ground_slam1",
        "ground_slam2": "ds:ground_slam2",
        "ground_slam3": "ds:ground_slam3",
        "ground_slam4": "ds:ground_slam4",
        "massive_roar1": "ds:massive_roar1",
        "massive_roar2": "ds:massive_roar2",
        "massive_roar3": "ds:massive_roar3",
        "massive_claw1": "ds:massive_claw1",
        "massive_claw2": "ds:massive_claw2"
      },
      "sound_effects": {
        "stomp": "mob.stomp",
        "step_sound": "random.sprint",
        "fizz_sound": "random.fizz",
        "shock1": "mob.shock1",
        "whoosh": "random.whoosh",
        "whoop": "random.whoop",
        "punch1": "mob.punch1",
        "bullet": "mob.strike",
        "swordslash": "mob.swordslash",
        "slash1": "mob.slash1",
        "sniper": "mob.bullet",
        "blocked": "random.blocked",
        "wind": "mob.wind",
        "flap": "mob.enderdragon.flap",
        "magic1": "mob.magic1",
        "explode_sound": "random.explode",
        "whoosh_sound": "mob.witch.throw",
        "splat": "mob.slime.jump",
        "movement": "mob.enderdragon.flap",
        "sheath": "armor.equip_chain"
      },
      "render_controllers": [
        "controller.render.default"
      ],
      "spawn_egg": {
        "base_color": "#0e151c",
        "overlay_color": "#9d1b30"
      }
    }
  }
}