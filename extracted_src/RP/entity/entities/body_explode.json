{
  "format_version": "1.12.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "ds:body_explode",
      "enable_attachables": true,
      "materials": {
        "default": "zombie"
      },
      "textures": {
        "default": "textures/models/body_explode"
      },
      "geometry": {
        "default": "geometry.body_explode"
      },
      "scripts": {
        "pre_animation": [
          "variable.tcos0 = (Math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;",
          "variable.attack = Math.sin((1.0 - (1.0 - variable.attack_time) * (1.0 - variable.attack_time)) * 180.0) * 57.3;",
          "variable.attack2 = Math.sin(variable.attack_time * 180.0) * 57.3;",
          "variable.z_bob = Math.cos(query.life_time * 103.13244) * 2.865 + 2.865;",
          "variable.x_bob = Math.sin(query.life_time * 76.776372) * 2.865;"
        ],
        "animate": [
          { "humanoid_big_head": "query.is_baby" },
          { "celebrate_hunt": "query.is_celebrating" },
          { "celebrate_hunt_special": "query.is_celebrating_special" },
          "move",
          "bob",
          "look_at_target_controller",
          "piglin_attack_controller",
          "riding_controller"
        ]
      },
      "animations": {
        "move": "animation.body_explode",
        "bob": "animation.body_explode",
        "humanoid_big_head": "animation.body_explode"
      },
      "particle_effects": {
        "headshot": "ds:headshot",
        "falling": "ds:falling"
      },
      "sound_effects": {
        "stomp": "mob.stomp",
        "step_sound": "random.sprint",
        "fizz_sound": "random.fizz",
        "shock1": "mob.shock1",
        "whoosh": "random.whoosh",
        "whoop": "random.whoop",
        "punch1": "mob.punch1",
        "bullet": "mob.strike",
        "swordslash": "mob.swordslash",
        "slash1": "mob.slash1",
        "sniper": "mob.bullet",
        "blocked": "random.blocked",
        "wind": "mob.wind",
        "flap": "mob.enderdragon.flap",
        "magic1": "mob.magic1",
        "explode_sound": "random.explode",
        "whoosh_sound": "mob.witch.throw",
        "splat": "mob.slime.jump",
        "movement": "mob.enderdragon.flap",
        "sheath": "armor.equip_chain"
      },
      "render_controllers": [
        "controller.render.default"
      ],
      "spawn_egg": {
        "base_color": "#91d8ff",
        "overlay_color": "#10151a"
      }
    }
  }
}