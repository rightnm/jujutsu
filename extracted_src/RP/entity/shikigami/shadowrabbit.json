{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "ds:shadowrabbit",
      "materials": {
        "default": "entity_alphablend"
      },
      "textures": {
        "default": "textures/entity/shikigami/shadowrabbit"
      },
      "geometry": {
        "default": "geometry.killer_bunny"
      },
      "animations": {
				"move": "animation.killer_bunny.move",
				"baby_transform": "animation.killer_bunny.baby_transform",
				"look_at_target": "animation.common.look_at_target"
      },
      "particle_effects": {
        "claw_slash1": "ds:claw_slash1",
        "claw_slash2": "ds:claw_slash2"
      },
      "scripts": {
          "animate": [
              "static",
              "attack_controller",
              "move_controller"
          ],
          "pre_animation": [
			  "variable.attack = Math.sin(variable.attack_time * 30.0);",
			  "variable.random = math.round(math.random(0,1));"
		  ]
      },
      "render_controllers": [
        "controller.render.default"
      ],
      "spawn_egg": {
        "texture": "enderman_spawn_egg"
      }
    }
  }
