{
	"materials": {
		"version": "1.0.0",
		"particles_blend_normal:particles_blend": {
			"blendSrc": "SourceAlpha",
			"blendDst": "OneMinusSrcAlpha"
		},
		"particles_blend_exclusion:particles_blend": {
			"blendSrc": "OneMinusDestColor",
			"blendDst": "OneMinusSrcColor"
		},
		"particles_blend_test:particles_blend": {
			"blendSrc": "SourceAlpha",
			"blendDst": "Zero"
		},	
		"particles_blend_multiply:particles_blend": {
			"blendSrc": "DestColor",
			"blendDst": "Zero"
		},
		"particles_blend_double_multiply:particles_blend": {
			"blendSrc": "DestColor",
			"blendDst": "SourceColor"
		},
		"particles_blend_additive:particles_blend": {
			"blendSrc": "One",
			"blendDst": "One"
		},
		"particles_blend_additive_blend:particles_blend": {
			"blendSrc": "SourceAlpha",
			"blendDst": "One"
		},
		"particles_blend_premultiplied_alpha:particles_blend": {
			"blendSrc": "One",
			"blendDst": "OneMinusSrcAlpha"
		},
		"particles_blend_opaque:particles_blend": {
			"blendSrc": "One",
			"blendDst": "Zero"
		},
			    // Greyscale Effect Material
    "particles_blend_greyscale:particles_blend": {
      "blendSrc": "SourceAlpha",
      "blendDst": "OneMinusSrcAlpha",
      "blendEquation": "Add",
      "colorTransform": {
        "redMultiplier": 0.299,
        "greenMultiplier": 0.587,
        "blueMultiplier": 0.114,
        "alphaMultiplier": 1.0,
        "redOffset": 0.0,
        "greenOffset": 0.0,
        "blueOffset": 0.0,
        "alphaOffset": 0.0
		}
	}
}
}